# Copy to .env and replace the JWT secret before running the API.
NODE_ENV=development
PORT=4000
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY=false

DATABASE_URL=postgres://alumnilink:alumnilink@localhost:5432/alumnilink
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Configure all four terms values together; v2 member routes need them.
CURRENT_TERMS_VERSION=2026-11-01
CURRENT_TERMS_EFFECTIVE_AT=2026-11-01T00:00:00Z
TERMS_URL=http://localhost:5173/terms
PRIVACY_URL=http://localhost:5173/privacy

# none | console | http. "console" only writes to the worker log; "http" posts to EMAIL_API_URL.
EMAIL_PROVIDER=none
# EMAIL_API_URL=https://api.example.com/email
# EMAIL_API_KEY=replace-me
EMAIL_FROM=AlumniLink <no-reply@alumnilink.test>
CLIENT_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60
# 0 keeps DM text out of emails and notification_outbox payloads; opt in with 1-240.
EMAIL_MESSAGE_PREVIEW_MAX_CHARS=0
NOTIFICATION_WORKER_POLL_MS=15000

# none | local. "local" stores uploads under STORAGE_LOCAL_DIR (development only).
STORAGE_PROVIDER=none
STORAGE_LOCAL_DIR=./storage/uploads
MEDIA_MAX_BYTES=5242880
# Per-account cumulative quota; enforced on every upload. Default 2 GiB.
MEDIA_STORAGE_QUOTA_BYTES=2147483648
